{
  "$defs": {
    "SourceLocation": {
      "description": "Original workbook location for a discovered object.",
      "properties": {
        "workbook_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workbook Path"
        },
        "sheet_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Name"
        },
        "sheet_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Index"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "object_type": {
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "ooxml_part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ooxml Part"
        },
        "source_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Identity"
        }
      },
      "required": [
        "object_type"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "ViewChunk": {
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "estimated_tokens": {
          "minimum": 0,
          "title": "Estimated Tokens",
          "type": "integer"
        },
        "over_budget_record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Over Budget Record Ids",
          "type": "array"
        }
      },
      "required": [
        "chunk_id",
        "record_ids",
        "estimated_tokens"
      ],
      "title": "ViewChunk",
      "type": "object"
    },
    "ViewRecord": {
      "properties": {
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "title": "Record Type",
          "type": "string"
        },
        "source_location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "facts": {
          "additionalProperties": true,
          "title": "Facts",
          "type": "object"
        }
      },
      "required": [
        "record_id",
        "record_type",
        "source_location"
      ],
      "title": "ViewRecord",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "phase1.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_type": {
      "const": "workbook_view",
      "default": "workbook_view",
      "title": "Artifact Type",
      "type": "string"
    },
    "view_id": {
      "title": "View Id",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "source_run_id": {
      "title": "Source Run Id",
      "type": "string"
    },
    "source_schema_version": {
      "title": "Source Schema Version",
      "type": "string"
    },
    "scope": {
      "enum": [
        "workbook",
        "sheet",
        "region"
      ],
      "title": "Scope",
      "type": "string"
    },
    "sheet_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sheet Name"
    },
    "region_address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Region Address"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ViewRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/ViewChunk"
      },
      "title": "Chunks",
      "type": "array"
    },
    "opaque_report": {
      "items": {
        "type": "string"
      },
      "title": "Opaque Report",
      "type": "array"
    }
  },
  "required": [
    "view_id",
    "source_id",
    "source_sha256",
    "source_run_id",
    "source_schema_version",
    "scope",
    "records",
    "chunks"
  ],
  "title": "WorkbookView",
  "type": "object"
}
